/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og-image.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:; connect-src 'self' https://*.onrender.com https://api.groq.com https://*.google.com https://www.google-analytics.com https://api.razorpay.com; frame-src https://api.razorpay.com; frame-ancestors 'none';
  Permissions-Policy: camera=(), microphone=(), geolocation=()

